<% content_for :title, "Pricing · #{Current.organization.name}" %>

<section class="py-10 sm:py-12" aria-labelledby="pricing-title">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Plans</p>
    <h1 id="pricing-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Simple, local plan comparison</h1>
    <p class="mt-3 text-slate-600">Plan and price information comes from the local catalog. Selecting or visiting a billing page never changes product access.</p>
  </div>

  <% if @plans.any? %>
    <div class="mt-8 grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
      <% @plans.each do |plan| %>
        <% active_prices = @active_prices_by_plan_id.fetch(plan.id, []) %>
        <% active_products = @active_products_by_plan_id.fetch(plan.id, []) %>
        <article class="flex h-full flex-col rounded-2xl border <%= plan == @effective_plan ? "border-indigo-500 ring-2 ring-indigo-100" : "border-slate-200" %> bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-xl font-bold text-slate-950"><%= plan.name %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= plan.description.presence || "A local plan offering." %></p>
            </div>
            <% if plan == @effective_plan %>
              <span class="whitespace-nowrap rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800">Current plan</span>
            <% end %>
          </div>

          <div class="mt-6">
            <% if plan.free? %>
              <p class="text-3xl font-bold text-slate-950">Free</p>
            <% elsif active_prices.any? %>
              <ul class="space-y-2">
                <% active_prices.each do |price| %>
                  <% mapping = @checkout_mappings_by_plan_price_id[price.id] %>
                  <li class="rounded-lg bg-slate-50 px-3 py-3 text-sm">
                    <div class="flex items-baseline justify-between gap-4">
                      <span class="font-medium text-slate-700"><%= price.billing_interval.humanize %></span>
                      <span class="font-bold text-slate-950"><%= number_to_currency(price.amount_cents / 100.0, unit: "#{price.currency} ") %></span>
                    </div>
                    <% if mapping&.test_mode? %>
                      <p class="mt-2 font-semibold text-amber-800">Test mode — no real charge</p>
                    <% end %>
                    <% if @can_checkout && mapping&.checkout_eligible? && !@pending_checkout_attempt && (@current_subscription.nil? || @current_subscription.status_expired?) %>
                      <%= button_to "Choose #{price.billing_interval}",
                        organization_billing_checkouts_path(organization_slug: Current.organization.slug),
                        params: { plan_price_id: price.id },
                        method: :post,
                        class: "mt-3 w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-500" %>
                    <% elsif @can_checkout && @current_subscription && !@current_subscription.status_expired? %>
                      <%= link_to "View current billing",
                        organization_billing_path(organization_slug: Current.organization.slug),
                        class: "mt-3 inline-flex font-semibold text-indigo-700 hover:text-indigo-600" %>
                    <% elsif @can_checkout && @pending_checkout_attempt %>
                      <%= link_to "View pending checkout",
                        organization_billing_checkout_pending_path(organization_slug: Current.organization.slug),
                        class: "mt-3 inline-flex font-semibold text-indigo-700 hover:text-indigo-600" %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm font-medium text-slate-600">No active public price.</p>
            <% end %>
          </div>

          <div class="mt-6 border-t border-slate-200 pt-5">
            <h3 class="text-sm font-semibold text-slate-950">Products</h3>
            <% if active_products.any? %>
              <ul class="mt-3 space-y-2 text-sm text-slate-600">
                <% active_products.each do |product| %>
                  <li class="flex gap-2"><span aria-hidden="true" class="text-emerald-600">✓</span><span><%= product.name %></span></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-3 text-sm text-slate-500">No products are listed for this plan.</p>
            <% end %>
          </div>

          <% if !plan.free? && !@can_checkout %>
            <p class="mt-5 text-sm text-slate-500">An organization owner or billing member can start checkout.</p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <h2 class="text-lg font-semibold text-slate-950">No plans are available</h2>
      <p class="mt-2 text-sm text-slate-600">Please contact support before attempting to use a locked product.</p>
    </div>
  <% end %>
</section>
