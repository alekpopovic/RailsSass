<% content_for :title, "#{Current.organization.name} billing" %>

<section class="py-10 sm:py-12" aria-labelledby="billing-title">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Organization</p>
  <h1 id="billing-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Billing overview</h1>
  <p class="mt-2 max-w-3xl text-slate-600">This page reflects the local subscription projection used for runtime access. Portal visits and provider API responses never change access; only a verified billing webhook can do that.</p>

  <% if @subscription %>
    <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">Current plan</p>
          <h2 class="mt-1 text-xl font-bold text-slate-950"><%= @subscription.plan_price.plan.name %></h2>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="w-fit rounded-full px-3 py-1 text-sm font-semibold <%= @subscription_access.allowed? ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-900" %>">
            <%= @subscription.status.humanize %>
          </span>
          <% if !Rails.env.production? && @subscription.test_mode? %>
            <span class="w-fit rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-900">Test mode</span>
          <% end %>
        </div>
      </div>

      <% if @subscription.status_past_due? %>
        <div role="alert" class="border-b border-amber-200 bg-amber-50 px-6 py-4 text-sm text-amber-950">
          Payment is past due. Access is available only during the configured grace period while a verified provider update is pending.
        </div>
      <% elsif @subscription.status_cancelled? %>
        <div role="alert" class="border-b border-amber-200 bg-amber-50 px-6 py-4 text-sm text-amber-950">
          This subscription is cancelled<%= @subscription.ends_at ? " and remains available until #{l(@subscription.ends_at, format: :long)}" : "" %>.
        </div>
      <% elsif @subscription.status_unpaid? %>
        <div role="alert" class="border-b border-red-200 bg-red-50 px-6 py-4 text-sm text-red-950">
          This subscription is unpaid. Paid product access is blocked until a verified billing event records recovery.
        </div>
      <% end %>

      <% if @current_compatibility&.over_limit? %>
        <div role="alert" class="border-b border-red-200 bg-red-50 px-6 py-4 text-sm text-red-950">
          <p class="font-semibold">Current usage is over a plan limit.</p>
          <div class="mt-3 grid gap-3">
            <% @current_compatibility.issues.select(&:over_limit?).each do |issue| %>
              <%= render "shared/entitlement_usage",
                usage: issue.usage_details,
                label: "#{issue.product_key.humanize} #{issue.feature_key.humanize.downcase}" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <dl class="grid gap-5 p-6 sm:grid-cols-2 lg:grid-cols-3">
        <div><dt class="text-sm font-medium text-slate-500">Billing interval</dt><dd class="mt-1 font-semibold text-slate-950"><%= @subscription.plan_price.billing_interval.humanize %></dd></div>
        <div><dt class="text-sm font-medium text-slate-500">Price</dt><dd class="mt-1 font-semibold text-slate-950"><%= number_to_currency(@subscription.plan_price.amount_cents / 100.0, unit: "#{@subscription.plan_price.currency} ") %></dd></div>
        <div><dt class="text-sm font-medium text-slate-500">Runtime access</dt><dd class="mt-1 font-semibold text-slate-950"><%= @subscription_access.allowed? ? "Available" : "Unavailable" %></dd></div>
        <div><dt class="text-sm font-medium text-slate-500">Trial ends</dt><dd class="mt-1 text-slate-950"><%= @subscription.trial_ends_at ? l(@subscription.trial_ends_at, format: :long) : "No active trial" %></dd></div>
        <% if @subscription.ends_at %>
          <div><dt class="text-sm font-medium text-slate-500">Ends</dt><dd class="mt-1 text-slate-950"><%= l(@subscription.ends_at, format: :long) %></dd></div>
        <% else %>
          <div><dt class="text-sm font-medium text-slate-500">Renews</dt><dd class="mt-1 text-slate-950"><%= @subscription.renews_at ? l(@subscription.renews_at, format: :long) : "Not scheduled" %></dd></div>
        <% end %>
        <div><dt class="text-sm font-medium text-slate-500">Payment method</dt><dd class="mt-1 text-slate-950"><%= @subscription.card_brand.present? ? "#{@subscription.card_brand.titleize} ending in #{@subscription.card_last_four}" : "Not available" %></dd></div>
      </dl>

      <div class="border-t border-slate-200 px-6 py-5">
        <%= button_to "Open customer portal",
          organization_billing_portal_path(organization_slug: Current.organization.slug),
          method: :post,
          class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
        <p class="mt-2 text-xs text-slate-500">A fresh signed portal link is requested from Lemon Squeezy on every click and is never stored.</p>
      </div>
    </div>

    <section class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" aria-labelledby="change-plan-title">
      <h2 id="change-plan-title" class="text-xl font-bold text-slate-950">Change plan</h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">Upgrade, downgrade, and interval requests remain pending until a matching verified billing event arrives. Your current effective plan does not change when this form is submitted.</p>

      <% if @open_plan_change %>
        <div role="status" class="mt-5 rounded-lg border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-950">
          <p class="font-semibold"><%= @open_plan_change.to_plan_price.plan.name %> · <%= @open_plan_change.to_plan_price.billing_interval.humanize %> is awaiting provider confirmation.</p>
          <p class="mt-1">Command status: <%= @open_plan_change.status.humanize %>. Duplicate submissions will not send another provider update.</p>
        </div>
      <% end %>

      <% if @plan_change_options.any? %>
        <div class="mt-5 grid gap-4 lg:grid-cols-2">
          <% @plan_change_options.each do |price, compatibility| %>
            <% label = compatibility.classification == :same_plan ? "Billing interval change" : compatibility.classification.to_s.humanize %>
            <article class="rounded-lg border border-slate-200 p-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700"><%= label %></p>
                  <h3 class="mt-1 font-bold text-slate-950"><%= price.plan.name %> · <%= price.billing_interval.humanize %></h3>
                </div>
                <p class="whitespace-nowrap font-semibold text-slate-950"><%= number_to_currency(price.amount_cents / 100.0, unit: "#{price.currency} ") %></p>
              </div>

              <% if compatibility.compatible? %>
                <%= button_to "Request #{label.downcase}",
                  organization_billing_plan_changes_path(organization_slug: Current.organization.slug),
                  params: { plan_price_id: price.id },
                  method: :post,
                  disabled: @open_plan_change.present?,
                  class: "mt-4 w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white enabled:cursor-pointer enabled:hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
              <% else %>
                <div class="mt-4 rounded-md bg-amber-50 p-3 text-sm text-amber-950">
                  <p class="font-semibold">This change is not currently compatible.</p>
                  <% compatibility.issues.each do |issue| %>
                    <p class="mt-1"><%= issue.message %><%= issue.usage.nil? ? "" : " Current usage: #{issue.usage}; target capacity: #{issue.capacity}." %></p>
                    <% if issue.usage_details&.remediation_items&.any? %>
                      <p class="mt-2 font-semibold">Remove or suspend before changing plan:</p>
                      <ul class="mt-1 list-disc space-y-1 pl-5">
                        <% issue.usage_details.remediation_items.each do |item| %>
                          <li><%= item.label %></li>
                        <% end %>
                      </ul>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </article>
          <% end %>
        </div>
      <% elsif @open_plan_change.nil? %>
        <p class="mt-5 rounded-lg border border-dashed border-slate-300 p-5 text-sm text-slate-600">No other active provider-mapped plan prices are available for this subscription.</p>
      <% end %>
    </section>

    <% if @latest_plan_change && !@latest_plan_change.status_pending? && !@latest_plan_change.status_submitted? && !@latest_plan_change.status_creation_unknown? %>
      <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6" aria-labelledby="latest-change-title">
        <h2 id="latest-change-title" class="font-bold text-slate-950">Latest completed plan request</h2>
        <p class="mt-2 text-sm text-slate-600"><%= @latest_plan_change.from_plan_price.plan.name %> to <%= @latest_plan_change.to_plan_price.plan.name %>: <span class="font-semibold"><%= @latest_plan_change.status.humanize %></span>.</p>
      </section>
    <% end %>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <h2 class="text-lg font-semibold text-slate-950">No paid subscription</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-slate-600">
        <% if @effective_plan %>
          Your organization currently uses the <%= @effective_plan.name %> plan.
        <% else %>
          No effective local plan is available. Product access fails closed.
        <% end %>
      </p>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "Compare plans", organization_pricing_path(organization_slug: Current.organization.slug), class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
  </div>
</section>
