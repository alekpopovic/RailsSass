<% content_for :title, "Analytics · #{Current.organization.name}" %>

<section class="py-10 sm:py-12" aria-labelledby="analytics-dashboard-title">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Analytics</p>
      <h1 id="analytics-dashboard-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Analytics dashboard</h1>
      <p class="mt-2 max-w-2xl text-slate-600">Reports and exports for <%= Current.organization.name %>.</p>
    </div>

    <% if @reports_decision.allowed? %>
      <%= link_to "View reports",
        organization_analytics_reports_path(organization_slug: Current.organization.slug),
        class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Current plan</p>
      <p class="mt-2 text-2xl font-bold text-slate-950"><%= Current.organization.effective_plan&.name || "Unavailable" %></p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Reports</p>
      <% if @reports_decision.allowed? %>
        <p class="mt-2 text-2xl font-bold text-slate-950"><%= @report_count %></p>
      <% else %>
        <p class="mt-2 text-sm text-slate-600">Your product role does not include report access.</p>
      <% end %>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Report capacity</p>
      <% if @create_decision.allowed? %>
        <p class="mt-2 text-2xl font-bold text-slate-950"><%= @create_decision.capacity == :unlimited ? "Unlimited" : @create_decision.capacity %></p>
      <% elsif @create_decision.reason_code == :permission_not_granted %>
        <p class="mt-2 text-sm text-slate-600">Your product role does not allow report creation.</p>
      <% else %>
        <p class="mt-2 text-sm text-slate-600">Report creation is not included in the current plan.</p>
      <% end %>
    </article>
  </div>
</section>
