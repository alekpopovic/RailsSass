<% content_for :title, "#{@report.name} · Analytics" %>

<section class="py-10 sm:py-12" aria-labelledby="report-title">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Analytics report</p>
      <h1 id="report-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @report.name %></h1>
      <p class="mt-3 max-w-3xl whitespace-pre-line text-slate-600"><%= @report.description.presence || "No description provided." %></p>
    </div>

    <% if @export_decision.allowed? %>
      <%= link_to "Export CSV",
        export_organization_analytics_report_path(
          organization_slug: Current.organization.slug,
          public_id: @report.public_id,
          format: :csv
        ),
        class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>

  <dl class="mt-8 grid gap-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-slate-500">Report ID</dt>
      <dd class="mt-1 break-all font-mono text-sm text-slate-900"><%= @report.public_id %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500">Created</dt>
      <dd class="mt-1 text-slate-900"><%= l @report.created_at, format: :long %></dd>
    </div>
  </dl>

  <%= link_to "Back to reports",
    organization_analytics_reports_path(organization_slug: Current.organization.slug),
    class: "mt-6 inline-flex font-semibold text-indigo-700 hover:text-indigo-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
</section>
