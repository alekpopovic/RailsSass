<% content_for :title, "Analytics reports · #{Current.organization.name}" %>

<section class="py-10 sm:py-12" aria-labelledby="reports-title">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Analytics</p>
      <h1 id="reports-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Reports</h1>
      <p class="mt-2 text-slate-600">Tenant-owned Analytics reports for <%= Current.organization.name %>.</p>
    </div>

    <% if @create_decision.allowed? %>
      <%= link_to "New report",
        new_organization_analytics_report_path(organization_slug: Current.organization.slug),
        class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>

  <% unless @create_decision.allowed? %>
    <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
      <% if @create_decision.reason_code == :permission_not_granted %>
        Your product role allows report reading but not report creation.
      <% else %>
        Report creation is unavailable on the current plan.
      <% end %>
    </div>
  <% end %>

  <% if @reports.any? %>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      <% @reports.each do |report| %>
        <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-semibold text-slate-950">
            <%= link_to report.name,
              organization_analytics_report_path(organization_slug: Current.organization.slug, public_id: report.public_id),
              class: "hover:text-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </h2>
          <p class="mt-2 text-sm text-slate-600"><%= report.description.presence || "No description provided." %></p>
          <p class="mt-4 text-xs text-slate-500">Created <%= l report.created_at, format: :long %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <h2 class="font-semibold text-slate-950">No reports yet</h2>
      <p class="mt-2 text-sm text-slate-600">Create the first report when your role and plan allow it.</p>
    </div>
  <% end %>
</section>
