<% content_for :title, "#{Current.organization.name} settings" %>

<section class="py-10 sm:py-12" aria-labelledby="settings-title">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Organization</p>
  <h1 id="settings-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Settings</h1>
  <p class="mt-2 max-w-2xl text-slate-600">Update the display name used throughout your workspace. The URL slug is permanent.</p>

  <div class="mt-8 max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <% if Current.organization.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% Current.organization.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: Current.organization,
      url: organization_settings_path(organization_slug: Current.organization.slug),
      method: :patch,
      class: "space-y-5" do |form| %>
      <div>
        <%= form.label :name, "Organization name", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name,
          required: true,
          maxlength: Organization::NAME_MAX_LENGTH,
          autocomplete: "organization",
          class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700">Organization URL</span>
        <code class="mt-2 block rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700">/o/<%= Current.organization.slug %></code>
        <p class="mt-1 text-xs text-slate-500">The stable slug cannot be changed.</p>
      </div>

      <%= form.submit "Save settings", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>
</section>
