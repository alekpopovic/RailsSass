<% content_for :title, "#{Current.organization.name} settings" %>

<section class="py-12">
  <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Organization</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Settings</h1>

  <dl class="mt-8 max-w-2xl rounded-xl border border-slate-200 bg-white p-6">
    <div>
      <dt class="text-sm font-semibold text-slate-500">Name</dt>
      <dd class="mt-1 text-slate-950"><%= Current.organization.name %></dd>
    </div>
    <div class="mt-5">
      <dt class="text-sm font-semibold text-slate-500">Slug</dt>
      <dd class="mt-1 text-slate-950"><%= Current.organization.slug %></dd>
    </div>
  </dl>
</section>
