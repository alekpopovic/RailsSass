<% content_for :title, "Products · #{Current.organization.name}" %>

<section class="py-10 sm:py-12" aria-labelledby="products-title">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Product catalog</p>
    <h1 id="products-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Products for <%= Current.organization.name %></h1>
    <p class="mt-3 text-slate-600">Product access requires both a plan entitlement and your own active product assignment with the required permission.</p>
  </div>

  <% if @product_cards.any? %>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% @product_cards.each do |card| %>
        <article class="flex h-full flex-col rounded-2xl border <%= card.available? ? "border-emerald-300" : "border-slate-200" %> bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-bold text-slate-950"><%= card.product.name %></h2>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= card.product.description.presence || "A product in the local catalog." %></p>
            </div>
            <span class="whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold <%= card.locked? ? "bg-slate-200 text-slate-700" : card.available? ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-900" %>">
              <%= card.locked? ? "Locked" : card.available? ? "Available" : card.state.to_s.humanize %>
            </span>
          </div>

          <p class="mt-5 flex-1 text-sm leading-6 <%= card.locked? ? "text-slate-600" : "text-slate-700" %>"><%= card.message %></p>

          <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-slate-200 pt-5">
            <% if card.available? && card.product.key == Products::Analytics::ActionRegistry::PRODUCT_KEY %>
              <%= link_to "Open Analytics",
                organization_analytics_dashboard_path(organization_slug: Current.organization.slug),
                class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
            <% elsif card.locked? %>
              <%= link_to "Compare plans",
                organization_pricing_path(organization_slug: Current.organization.slug),
                class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
            <% else %>
              <span class="text-sm font-medium text-slate-500">No product action available</span>
            <% end %>

            <% management_record = Current.organization.product_memberships.new(product: card.product) %>
            <% if policy(management_record).index? %>
              <%= link_to "Manage product members",
                organization_product_members_path(
                  organization_slug: Current.organization.slug,
                  product_key: card.product.key
                ),
                class: "font-semibold text-indigo-700 hover:text-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <h2 class="text-lg font-semibold text-slate-950">No active products</h2>
      <p class="mt-2 text-sm text-slate-600">The customer product catalog is currently empty.</p>
    </div>
  <% end %>
</section>
