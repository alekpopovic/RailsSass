<% content_for :title, "Invitation to #{Current.organization.name}" %>

<section class="mx-auto max-w-lg py-12 sm:py-16" aria-labelledby="invitation-acceptance-title">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Organization invitation</p>
    <h1 id="invitation-acceptance-title" class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
      Join <%= Current.organization.name %>
    </h1>
    <p class="mt-3 text-sm text-slate-600">
      You were invited as <strong><%= @invitation.organization_role.humanize.downcase %></strong>.
    </p>

    <%= form_with url: organization_invitation_acceptance_path(
        organization_slug: Current.organization.slug
      ), method: :patch, class: "mt-6" do |form| %>
      <%= form.hidden_field :token, value: @raw_token %>
      <%= form.submit "Accept invitation", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>
</section>
