<% content_for :title, "Audit log · #{Current.organization.name}" %>

<section class="py-8" aria-labelledby="audit-log-title">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Organization security</p>
    <h1 id="audit-log-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Audit log</h1>
    <p class="mt-2 max-w-3xl text-slate-600">
      Immutable organization activity for <%= Current.organization.name %>. Events are newest first and cannot be edited or deleted.
    </p>
  </div>

  <% if @audit_events_page.records.empty? %>
    <div class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
      <h2 class="text-lg font-semibold text-slate-950">No audit activity yet</h2>
      <p class="mt-2 text-sm text-slate-600">Security and lifecycle events will appear here as they occur.</p>
    </div>
  <% else %>
    <ol class="mt-8 space-y-4" aria-label="Organization audit events">
      <% @audit_events_page.records.each do |event| %>
        <li data-audit-event-id="<%= event.id %>" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
            <div>
              <h2 class="font-semibold text-slate-950"><%= audit_event_action_label(event) %></h2>
              <p class="mt-1 text-sm text-slate-600">
                By <span class="font-medium text-slate-800"><%= event.actor_user&.name || "System / provider" %></span>
                · <%= audit_event_subject_label(event) %>
              </p>
            </div>
            <time datetime="<%= event.created_at.iso8601 %>" class="whitespace-nowrap text-sm text-slate-500">
              <%= l event.created_at, format: :long %>
            </time>
          </div>

          <% details = audit_event_metadata_details(event) %>
          <% if details.any? %>
            <dl class="mt-4 grid gap-3 border-t border-slate-100 pt-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
              <% details.each do |label, value| %>
                <div>
                  <dt class="font-medium text-slate-500"><%= label %></dt>
                  <dd class="mt-1 text-slate-900"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          <% end %>
        </li>
      <% end %>
    </ol>

    <% if @audit_events_page.number > 1 || @audit_events_page.has_next %>
      <nav aria-label="Audit log pages" class="mt-6 flex items-center justify-between text-sm">
        <% if @audit_events_page.number > 1 %>
          <%= link_to "Previous",
            organization_audit_events_path(
              organization_slug: Current.organization.slug,
              page: @audit_events_page.number - 1
            ),
            class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
        <% else %>
          <span></span>
        <% end %>

        <% if @audit_events_page.has_next %>
          <%= link_to "Next",
            organization_audit_events_path(
              organization_slug: Current.organization.slug,
              page: @audit_events_page.number + 1
            ),
            class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
        <% end %>
      </nav>
    <% end %>
  <% end %>
</section>
