<% content_for :title, "Create account" %>

<section class="mx-auto max-w-md py-12 sm:py-16" aria-labelledby="registration-title">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 id="registration-title" class="text-2xl font-bold tracking-tight text-slate-950">Create your account</h1>
    <p class="mt-2 text-sm text-slate-600">We will send a verification link before you can sign in.</p>

    <% if @user.errors.any? %>
      <div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm font-medium text-slate-700" %>
        <p class="mt-1 text-xs text-slate-500">Use at least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
        <%= form.password_field :password, required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, autocomplete: "new-password", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password_confirmation, required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, autocomplete: "new-password", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <%= form.submit "Create account", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      Already registered? <%= link_to "Sign in", new_session_path, class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
    </p>
  </div>
</section>
