<% content_for :title, "Profile settings" %>

<section class="mx-auto max-w-2xl py-10 sm:py-14" aria-labelledby="profile-title">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Account</p>
    <h1 id="profile-title" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Profile settings</h1>
    <p class="mt-2 text-sm text-slate-600">Your email address is verified identity data and cannot be changed from this form.</p>

    <% if @user.errors.any? %>
      <div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name,
          required: true,
          maxlength: User::NAME_MAX_LENGTH,
          autocomplete: "name",
          class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700">Email address</span>
        <p class="mt-2 rounded-lg bg-slate-100 px-3 py-2 text-slate-700"><%= @user.email_address %></p>
      </div>

      <%= form.submit "Save profile", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>

    <div class="mt-8 border-t border-slate-200 pt-6">
      <h2 class="font-semibold text-slate-950">Account security</h2>
      <div class="mt-3 flex flex-wrap gap-4 text-sm">
        <%= link_to "Manage active sessions", active_sessions_path, class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
        <%= link_to "Reset password", new_password_path, class: "font-semibold text-indigo-700 hover:text-indigo-600" %>
      </div>
    </div>
  </div>
</section>
