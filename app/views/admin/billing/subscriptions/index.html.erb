<% content_for :title, "Subscriptions · Admin" %>
<section class="py-8"><div><p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Billing diagnostics</p><h1 class="mt-1 text-3xl font-bold">Subscriptions</h1><p class="mt-2 text-slate-600">Enter one exact organization public ID. Subscription rows are then loaded through <code>Current.organization</code>.</p></div>
  <%= form_with url: admin_billing_subscriptions_path, method: :get, class: "mt-6 flex max-w-2xl flex-wrap items-end gap-3" do |form| %><div class="min-w-72 flex-1"><%= form.label :organization_public_id, "Organization public ID", class: "block text-sm font-semibold" %><%= form.text_field :organization_public_id, value: @organization&.public_id || params[:organization_public_id], required: true, autocomplete: "off", class: "mt-2 w-full rounded-lg border-slate-300" %></div><%= form.submit "View subscriptions", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %><% end %>
  <% if @organization %><div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white"><table class="min-w-full divide-y divide-slate-200 text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-600"><tr><th class="px-4 py-3">Plan</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Environment</th><th class="px-4 py-3">Updated</th></tr></thead><tbody class="divide-y divide-slate-100"><% @subscriptions_page.records.each do |subscription| %><tr><td class="px-4 py-3"><%= link_to subscription.plan_price.plan.key, admin_billing_subscription_path(subscription, organization_public_id: @organization.public_id), class: "font-semibold text-indigo-700" %></td><td class="px-4 py-3"><%= subscription.status %><%= " (archived)" unless subscription.current? %></td><td class="px-4 py-3"><%= subscription.environment %></td><td class="px-4 py-3"><%= l subscription.provider_updated_at, format: :short %></td></tr><% end %></tbody></table></div>
    <% if @subscriptions_page.number > 1 || @subscriptions_page.has_next %><nav aria-label="Subscription pages" class="mt-4 flex items-center justify-between text-sm"><% if @subscriptions_page.number > 1 %><%= link_to "Previous", admin_billing_subscriptions_path(organization_public_id: @organization.public_id, page: @subscriptions_page.number - 1), class: "font-semibold text-indigo-700" %><% else %><span></span><% end %><% if @subscriptions_page.has_next %><%= link_to "Next", admin_billing_subscriptions_path(organization_public_id: @organization.public_id, page: @subscriptions_page.number + 1), class: "font-semibold text-indigo-700" %><% end %></nav><% end %>
  <% end %>
</section>
