<% content_for :title, "Subscription #{@subscription.id} · Admin" %>
<section class="py-8"><p class="text-sm text-slate-500"><%= @organization.name %> · <%= @organization.public_id %></p><h1 class="mt-1 text-3xl font-bold">Subscription diagnostic</h1><dl class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-3"><div><dt class="text-xs uppercase text-slate-500">Plan</dt><dd class="mt-1 font-semibold"><%= @subscription.plan_price.plan.key %></dd></div><div><dt class="text-xs uppercase text-slate-500">Price</dt><dd class="mt-1"><%= @subscription.plan_price.billing_interval %> · <%= @subscription.plan_price.currency %> <%= @subscription.plan_price.amount_cents %> cents</dd></div><div><dt class="text-xs uppercase text-slate-500">Status</dt><dd class="mt-1 font-semibold"><%= @subscription.status %></dd></div><div><dt class="text-xs uppercase text-slate-500">Provider identity</dt><dd class="mt-1 break-all font-mono text-xs"><%= @subscription.provider_subscription_id %></dd></div><div><dt class="text-xs uppercase text-slate-500">Environment</dt><dd class="mt-1"><%= @subscription.environment %></dd></div><div><dt class="text-xs uppercase text-slate-500">Provider updated</dt><dd class="mt-1"><%= l @subscription.provider_updated_at, format: :long %></dd></div><div><dt class="text-xs uppercase text-slate-500">Renews</dt><dd class="mt-1"><%= @subscription.renews_at ? l(@subscription.renews_at, format: :long) : "—" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Ends</dt><dd class="mt-1"><%= @subscription.ends_at ? l(@subscription.ends_at, format: :long) : "—" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Archived</dt><dd class="mt-1"><%= @subscription.archived_at ? l(@subscription.archived_at, format: :long) : "Current" %></dd></div></dl><p class="mt-6 text-sm text-slate-500">Diagnostic payloads, pause data, customer identity, card data, API credentials, and webhook secrets are intentionally not rendered.</p></section>
