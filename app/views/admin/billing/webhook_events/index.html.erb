<% content_for :title, "Failed webhooks · Admin" %>
<section class="py-8"><p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Billing diagnostics</p><h1 class="mt-1 text-3xl font-bold">Failed webhook events</h1><div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white"><table class="min-w-full divide-y divide-slate-200 text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-600"><tr><th class="px-4 py-3">Event</th><th class="px-4 py-3">Environment</th><th class="px-4 py-3">Error</th><th class="px-4 py-3">Attempts</th><th class="px-4 py-3">Received</th></tr></thead><tbody class="divide-y divide-slate-100"><% @webhook_events_page.records.each do |event| %><tr><td class="px-4 py-3"><%= link_to event.event_name.presence || "Unknown event", admin_billing_webhook_event_path(event), class: "font-semibold text-indigo-700" %></td><td class="px-4 py-3"><%= event.environment %></td><td class="px-4 py-3 font-mono text-xs"><%= event.error_code %></td><td class="px-4 py-3"><%= event.attempt_count %></td><td class="px-4 py-3"><%= l event.received_at, format: :short %></td></tr><% end %></tbody></table></div>
  <% if @webhook_events_page.number > 1 || @webhook_events_page.has_next %><nav aria-label="Failed webhook pages" class="mt-4 flex items-center justify-between text-sm"><% if @webhook_events_page.number > 1 %><%= link_to "Previous", admin_billing_webhook_events_path(page: @webhook_events_page.number - 1), class: "font-semibold text-indigo-700" %><% else %><span></span><% end %><% if @webhook_events_page.has_next %><%= link_to "Next", admin_billing_webhook_events_path(page: @webhook_events_page.number + 1), class: "font-semibold text-indigo-700" %><% end %></nav><% end %>
</section>
