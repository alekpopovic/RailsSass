<% content_for :title, "Failed webhook #{@webhook_event.id} · Admin" %>
<section class="py-8"><p class="text-sm font-semibold uppercase tracking-wide text-red-700">Failed webhook</p><h1 class="mt-1 text-3xl font-bold"><%= @webhook_event.event_name.presence || "Unknown event" %></h1><dl class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-3"><div><dt class="text-xs uppercase text-slate-500">Status</dt><dd class="mt-1 font-semibold"><%= @webhook_event.status %></dd></div><div><dt class="text-xs uppercase text-slate-500">Environment</dt><dd class="mt-1"><%= @webhook_event.environment %></dd></div><div><dt class="text-xs uppercase text-slate-500">Error code</dt><dd class="mt-1 font-mono text-xs"><%= @webhook_event.error_code %></dd></div><div><dt class="text-xs uppercase text-slate-500">Provider event ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @webhook_event.provider_event_id.presence || "Unavailable" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Provider resource ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @webhook_event.provider_resource_id.presence || "Unavailable" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Attempts</dt><dd class="mt-1"><%= @webhook_event.attempt_count %></dd></div><div><dt class="text-xs uppercase text-slate-500">Received</dt><dd class="mt-1"><%= l @webhook_event.received_at, format: :long %></dd></div><div><dt class="text-xs uppercase text-slate-500">Verified</dt><dd class="mt-1"><%= l @webhook_event.verified_at, format: :long %></dd></div><div><dt class="text-xs uppercase text-slate-500">Processed</dt><dd class="mt-1"><%= @webhook_event.processed_at ? l(@webhook_event.processed_at, format: :long) : "—" %></dd></div></dl><p class="mt-6 text-sm text-slate-500">The fingerprint, snapshot, raw request body, signatures, API credentials, and webhook secrets are intentionally not rendered.</p></section>
