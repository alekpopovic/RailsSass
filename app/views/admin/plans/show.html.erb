<% content_for :title, "#{@plan.key} · Admin" %>
<section class="py-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div><p class="font-mono text-sm text-indigo-700"><%= @plan.key %></p><h1 class="mt-1 text-3xl font-bold"><%= @plan.name %></h1><p class="mt-2 max-w-3xl text-slate-600"><%= @plan.description %></p></div>
    <%= link_to "Edit plan", edit_admin_plan_path(@plan.key), class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-slate-50" %>
  </div>
  <dl class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-3">
    <div><dt class="text-xs uppercase text-slate-500">Status</dt><dd class="mt-1 font-semibold"><%= @plan.active? ? "Active" : "Inactive" %></dd></div>
    <div><dt class="text-xs uppercase text-slate-500">Plan type</dt><dd class="mt-1 font-semibold"><%= @plan.free? ? "Free fallback" : "Paid" %></dd></div>
    <div><dt class="text-xs uppercase text-slate-500">Position</dt><dd class="mt-1 font-semibold"><%= @plan.position %></dd></div>
  </dl>
  <div class="mt-8 grid gap-5 md:grid-cols-2">
    <%= link_to admin_plan_plan_products_path(@plan.key), class: "rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-indigo-300" do %><h2 class="font-semibold">Plan products</h2><p class="mt-2 text-sm text-slate-600">Manage product and feature entitlements.</p><% end %>
    <%= link_to admin_plan_plan_prices_path(@plan.key), class: "rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:border-indigo-300" do %><h2 class="font-semibold">Plan prices</h2><p class="mt-2 text-sm text-slate-600">Manage local price and provider identifiers.</p><% end %>
  </div>
</section>
