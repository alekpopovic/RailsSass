<% content_for :title, "#{@entitlement.product_feature.key} entitlement · Admin" %>
<section class="py-8"><p class="text-sm text-slate-500"><%= @plan.key %> / <%= @product.key %></p><h1 class="mt-1 text-3xl font-bold"><%= @entitlement.product_feature.name %></h1><p class="font-mono text-sm text-indigo-700"><%= @entitlement.product_feature.key %></p><dl class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-3"><div><dt class="text-xs uppercase text-slate-500">Kind</dt><dd class="mt-1 font-semibold"><%= @entitlement.feature_kind %></dd></div><div><dt class="text-xs uppercase text-slate-500">Enabled</dt><dd class="mt-1 font-semibold"><%= @entitlement.enabled? ? "Yes" : "No" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Capacity</dt><dd class="mt-1 font-semibold"><%= @entitlement.flag? ? "Not applicable" : (@entitlement.unlimited? ? "Unlimited" : @entitlement.limit_value) %></dd></div></dl><div class="mt-6"><%= link_to "Edit entitlement", admin_edit_plan_feature_entitlement_path(plan_key: @plan.key, product_key: @product.key, feature_key: @entitlement.product_feature.key), class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold" %></div></section>
