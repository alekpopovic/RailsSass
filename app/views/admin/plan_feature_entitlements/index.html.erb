<% content_for :title, "#{@plan.key} #{@product.key} entitlements · Admin" %>
<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-4"><div><p class="text-sm text-slate-500"><%= @plan.key %> / <%= @product.key %></p><h1 class="text-3xl font-bold">Feature entitlements</h1></div><% if @plan.active? && @product.active? %><%= link_to "New entitlement", admin_new_plan_feature_entitlement_path(plan_key: @plan.key, product_key: @product.key), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %><% else %><span class="rounded-lg bg-slate-200 px-4 py-2 text-sm font-semibold text-slate-600">Activate plan and product to add entitlements</span><% end %></div>
  <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white"><table class="min-w-full divide-y divide-slate-200 text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-600"><tr><th class="px-4 py-3">Feature</th><th class="px-4 py-3">Kind</th><th class="px-4 py-3">Enabled</th><th class="px-4 py-3">Capacity</th></tr></thead><tbody class="divide-y divide-slate-100"><% @entitlements.each do |entitlement| %><tr><td class="px-4 py-3"><%= link_to entitlement.product_feature.key, admin_plan_feature_entitlement_path(plan_key: @plan.key, product_key: @product.key, feature_key: entitlement.product_feature.key), class: "font-mono text-xs font-semibold text-indigo-700" %></td><td class="px-4 py-3"><%= entitlement.feature_kind %></td><td class="px-4 py-3"><%= entitlement.enabled? ? "Yes" : "No" %></td><td class="px-4 py-3"><%= entitlement.flag? ? "—" : (entitlement.unlimited? ? "Unlimited" : entitlement.limit_value) %></td></tr><% end %></tbody></table></div>
</section>
