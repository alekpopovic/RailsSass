<% form_url = product.persisted? ? admin_product_path(product.key) : admin_products_path %>
<% form_method = product.persisted? ? :patch : :post %>

<%= render "admin/shared/errors", record: product %>

<%= form_with model: product, url: form_url, method: form_method, class: "mt-6 space-y-5" do |form| %>
  <% unless product.persisted? %>
    <div>
      <%= form.label :key, "Stable key", class: "block text-sm font-medium text-slate-700" %>
      <p id="product-key-hint" class="mt-1 text-xs text-slate-500">Lowercase letters, numbers, and underscores. This identity cannot be changed after creation.</p>
      <%= form.text_field :key,
        required: true,
        autofocus: true,
        maxlength: Product::KEY_MAX_LENGTH,
        pattern: "[a-z][a-z0-9]*(?:_[a-z0-9]+)*",
        autocomplete: "off",
        aria: { describedby: "product-key-hint" },
        class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 font-mono shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  <% else %>
    <div>
      <p class="text-sm font-medium text-slate-700">Stable key</p>
      <p class="mt-2 rounded-lg bg-slate-100 px-3 py-2 font-mono text-sm text-slate-900"><%= product.key %></p>
      <p class="mt-1 text-xs text-slate-500">Stable keys are immutable after creation.</p>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name,
      required: true,
      maxlength: Product::NAME_MAX_LENGTH,
      autofocus: product.persisted?,
      class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :description,
      rows: 5,
      maxlength: Product::DESCRIPTION_MAX_LENGTH,
      class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
    <div class="flex items-start gap-3">
      <%= form.checkbox :active, class: "mt-1 size-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
      <div>
        <%= form.label :active, "Active for new catalog selections", class: "font-medium text-slate-900" %>
        <p class="mt-1 text-sm text-slate-600">Deactivation preserves existing references and is not an immediate product-access kill switch.</p>
      </div>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <%= link_to "Cancel",
      product.persisted? ? admin_product_path(product.key) : admin_products_path,
      class: "rounded-lg border border-slate-300 px-4 py-2.5 text-center font-semibold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <%= form.submit product.persisted? ? "Save product" : "Create product",
      class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  </div>
<% end %>
