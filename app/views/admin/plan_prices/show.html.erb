<% content_for :title, "Price #{@plan_price.id} · Admin" %>

<section class="py-8">
  <p class="text-sm text-slate-500">Plan <%= @plan.key %></p>
  <h1 class="text-3xl font-bold"><%= @plan_price.billing_interval.titleize %> price</h1>

  <dl class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-4">
    <div><dt class="text-xs uppercase text-slate-500">Amount</dt><dd class="mt-1 font-semibold"><%= number_to_currency(@plan_price.amount_cents / 100.0, unit: "#{@plan_price.currency} ") %></dd></div>
    <div><dt class="text-xs uppercase text-slate-500">Status</dt><dd class="mt-1 font-semibold"><%= @plan_price.active? ? "Active" : "Inactive" %></dd></div>
    <div><dt class="text-xs uppercase text-slate-500">Store ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @plan_price.lemon_store_id.presence || "Not mapped" %></dd></div>
    <div><dt class="text-xs uppercase text-slate-500">Variant ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @plan_price.lemon_variant_id.presence || "Not mapped" %></dd></div>
  </dl>

  <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
    <h2 class="text-xl font-bold text-slate-950">Checkout environments</h2>
    <% if @plan_price.lemon_variant_id.present? && @plan_price.active? && @plan.active? && !@plan.free? %>
      <%= link_to "Add environment mapping",
        new_admin_plan_plan_price_provider_price_mapping_path(@plan.key, @plan_price),
        class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <% if @provider_price_mappings.any? %>
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-600"><tr><th class="px-4 py-3">Environment</th><th class="px-4 py-3">Selection</th><th class="px-4 py-3">Action</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% @provider_price_mappings.each do |mapping| %>
            <tr>
              <td class="px-4 py-3"><span class="rounded-full px-3 py-1 font-semibold <%= mapping.test_mode? ? "bg-amber-100 text-amber-900" : "bg-emerald-100 text-emerald-900" %>"><%= mapping.test_mode? ? "Test mode" : "Live mode" %></span></td>
              <td class="px-4 py-3"><%= mapping.active? ? "Active" : "Inactive" %></td>
              <td class="px-4 py-3"><%= link_to "Edit", edit_admin_plan_plan_price_provider_price_mapping_path(@plan.key, @plan_price, mapping.environment), class: "font-semibold text-indigo-700" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 p-5 text-sm text-slate-600">No test/live checkout mapping is configured. This price cannot start checkout.</p>
  <% end %>

  <div class="mt-6"><%= link_to "Edit price", edit_admin_plan_plan_price_path(@plan.key, @plan_price), class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold" %></div>
</section>
