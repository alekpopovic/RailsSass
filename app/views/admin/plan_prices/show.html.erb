<% content_for :title, "Price #{@plan_price.id} · Admin" %>
<section class="py-8"><p class="text-sm text-slate-500">Plan <%= @plan.key %></p><h1 class="text-3xl font-bold"><%= @plan_price.billing_interval.titleize %> price</h1><dl class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-4"><div><dt class="text-xs uppercase text-slate-500">Amount</dt><dd class="mt-1 font-semibold"><%= number_to_currency(@plan_price.amount_cents / 100.0, unit: "#{@plan_price.currency} ") %></dd></div><div><dt class="text-xs uppercase text-slate-500">Status</dt><dd class="mt-1 font-semibold"><%= @plan_price.active? ? "Active" : "Inactive" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Store ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @plan_price.lemon_store_id.presence || "Not mapped" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Variant ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @plan_price.lemon_variant_id.presence || "Not mapped" %></dd></div></dl><div class="mt-6"><%= link_to "Edit price", edit_admin_plan_plan_price_path(@plan.key, @plan_price), class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold" %></div></section>
