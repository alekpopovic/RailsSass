<% content_for :title, "Verify email address" %>

<section class="mx-auto max-w-md py-12 sm:py-16" aria-labelledby="verification-title">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm sm:p-8">
    <h1 id="verification-title" class="text-2xl font-bold tracking-tight text-slate-950">Verify your email address</h1>
    <p class="mt-3 text-sm text-slate-600">Confirm to enable sign-in for this account.</p>

    <%= form_with url: email_verification_path, method: :patch, class: "mt-6" do |form| %>
      <%= hidden_field_tag :token, @token %>
      <%= form.submit "Verify email address", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>
</section>
