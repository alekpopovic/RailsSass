<% content_for :title, "Choose a new password" %>

<section class="mx-auto max-w-md py-12 sm:py-16" aria-labelledby="password-edit-title">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 id="password-edit-title" class="text-2xl font-bold tracking-tight text-slate-950">Choose a new password</h1>

    <% if @user.errors.any? %>
      <div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <ul class="list-disc space-y-1 pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: password_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <%= hidden_field_tag :token, @token %>

      <div>
        <%= form.label :password, "New password", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, autofocus: true, minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, autocomplete: "new-password", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password_confirmation, required: true, minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, autocomplete: "new-password", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <%= form.submit "Update password", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
  </div>
</section>
