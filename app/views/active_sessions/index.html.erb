<% content_for :title, "Active sessions" %>

<section class="mx-auto max-w-3xl py-12 sm:py-16" aria-labelledby="sessions-title">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <h1 id="sessions-title" class="text-2xl font-bold tracking-tight text-slate-950">Active sessions</h1>
    <p class="mt-2 text-sm text-slate-600">Sign out sessions you no longer recognize.</p>

    <ul class="mt-6 divide-y divide-slate-200">
      <% @sessions.each do |session_record| %>
        <li class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-medium text-slate-900">
              <%= session_record.user_agent.presence || "Unknown browser" %>
              <% if session_record == Current.session %>
                <span class="ml-2 rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-800">Current</span>
              <% end %>
            </p>
            <p class="mt-1 text-sm text-slate-500">
              Created <%= time_tag session_record.created_at, session_record.created_at.to_fs(:long) %>
              <% if session_record.ip_address.present? %>
                · <%= session_record.ip_address %>
              <% end %>
            </p>
          </div>

          <%= button_to "Sign out", active_session_path(session_record), method: :delete, class: "cursor-pointer rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
