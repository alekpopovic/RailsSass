<% content_for :title, "RailsSass foundation" %>

<section class="mx-auto max-w-4xl py-16 sm:py-24" aria-labelledby="page-title">
  <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-12">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">Rails 8.1 modular monolith</p>
    <h1 id="page-title" class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl">
      RailsSass foundation
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
      The application foundation is ready for small, test-driven domain increments.
      Runtime tenant access and billing behavior will be added only behind server-side
      authorization and verified webhook processing.
    </p>

    <dl class="mt-10 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl bg-slate-50 p-5">
        <dt class="text-sm font-medium text-slate-500">Application</dt>
        <dd class="mt-1 font-semibold text-slate-900">Rails + Hotwire</dd>
      </div>
      <div class="rounded-2xl bg-slate-50 p-5">
        <dt class="text-sm font-medium text-slate-500">Data</dt>
        <dd class="mt-1 font-semibold text-slate-900">PostgreSQL</dd>
      </div>
      <div class="rounded-2xl bg-slate-50 p-5">
        <dt class="text-sm font-medium text-slate-500">Jobs</dt>
        <dd class="mt-1 font-semibold text-slate-900">Solid Queue</dd>
      </div>
    </dl>
  </div>
</section>
