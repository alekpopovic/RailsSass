# Synthetic development-only defaults used by the Compose PostgreSQL service.
# This file must never contain production credentials.
PORT=3000
# RAILS_MAX_THREADS=5
# JOB_CONCURRENCY=1
# TEST_WORKERS=1

# Host Rails connects to the published Compose port. The Compose app service
# overrides PGHOST with the internal service name and PGPORT with 5432.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=rails_sass
PGPASSWORD=rails_sass

# Native PostgreSQL users may replace or remove the PG* values in their ignored
# .env. Alternatively, Rails accepts a complete connection URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rails_sass_development

# Non-secret mail URL defaults. Production must provide its canonical hostname
# and a verified sender through the deployment environment.
APP_HOST=localhost
MAILER_FROM=no-reply@example.test

# MailCatcher receives all development email locally. SMTP_PORT is also the
# host port published by Compose; the containerized app uses port 1025 inside
# the Compose network regardless of this host-side value.
SMTP_ADDRESS=127.0.0.1
SMTP_PORT=1025
MAILCATCHER_HTTP_PORT=1080

# Non-secret local billing policy. Invalid or negative values fail application
# boot so a configuration mistake cannot silently extend paid access.
ENTITLEMENTS_PAST_DUE_GRACE_DAYS=15

# Optional Lemon Squeezy adapter credentials. Keep these placeholders empty in
# the tracked example; production values come from the deployment secret store.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Optional bounded rotation pair. Set both only during a cutover; the strict UTC
# expiry must be in the future and no more than seven days after process boot.
LEMON_SQUEEZY_WEBHOOK_PREVIOUS_SECRET=
LEMON_SQUEEZY_WEBHOOK_PREVIOUS_SECRET_EXPIRES_AT=
# Non-secret provider boundary. Development defaults to test; production must
# explicitly use live and the exact Lemon checkout/customer-portal hostname.
LEMON_SQUEEZY_ENVIRONMENT=test
LEMON_SQUEEZY_CHECKOUT_HOST=
