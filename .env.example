# Optional local process overrides. This file must never contain real credentials.
# PORT=3000
# RAILS_MAX_THREADS=5
# JOB_CONCURRENCY=1
# TEST_WORKERS=1

# PostgreSQL uses the current operating-system user and local socket by default.
# Uncomment and complete these only when your local server needs TCP settings.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=
# PGPASSWORD=

# Alternatively, Rails accepts a complete connection URL. Keep passwords out of
# this tracked example and use a synthetic local-only value in .env.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rails_sass_development

# Lemon Squeezy credential names will be introduced with the billing adapter.
# No provider credential is required by the project foundation.
